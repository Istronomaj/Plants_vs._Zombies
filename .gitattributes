# Normalize line endings on checkin; check out native.
* text=auto eol=lf

# Sources and config
*.cpp    text eol=lf
*.hpp    text eol=lf
*.h      text eol=lf
*.cmake  text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
CMakeLists.txt text eol=lf

# Shell scripts must be LF or Linux CI fails with "bad interpreter: ...^M"
*.sh     text eol=lf

# Windows-only scripts keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary assets
*.png    binary
*.jpg    binary
*.ttf    binary
*.otf    binary
*.gif    binary
